<Window x:Class="TscLabel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TscLabel.App"
        Title="Etikettenstudio"
        Icon="Assets/sozo-omega.ico"
        Width="1240" Height="880" MinWidth="1040" MinHeight="740" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#F3F7F7"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Petrol" Color="#0F6F73" />
        <SolidColorBrush x:Key="PetrolDark" Color="#0A5559" />
        <SolidColorBrush x:Key="PetrolPale" Color="#E5F3F3" />
        <SolidColorBrush x:Key="Ink" Color="#17242B" />
        <SolidColorBrush x:Key="Muted" Color="#64757D" />
        <SolidColorBrush x:Key="Line" Color="#D4E0E1" />
        <SolidColorBrush x:Key="Success" Color="#137A52" />
        <SolidColorBrush x:Key="Warning" Color="#B66A13" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Petrol}" />
            <Setter Property="BorderBrush" Value="{StaticResource Petrol}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource PetrolDark}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{StaticResource PetrolDark}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="ImageFocusToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource PetrolDark}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF3E6" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E47A13" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Petrol}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="18,10" />
        </Style>
        <DataTemplate x:Key="PrinterItemTemplate">
            <Grid MinWidth="240" ToolTip="{Binding Name}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Text="{Binding ConnectionText}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LabelTemplateItemTemplate">
            <Grid MinWidth="190">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" FontSize="10.5" Foreground="{StaticResource Muted}">
                    <Run Text="{Binding StoreScopeLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PrinterName}" /><Run Text=" · " /><Run Text="{Binding ProfileName}" /><Run Text=" · " /><Run Text="{Binding WidthMm, StringFormat={}{0:0.##}}" /><Run Text=" × " /><Run Text="{Binding HeightMm, StringFormat={}{0:0.##}}" /><Run Text=" mm" />
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactTemplateNameItemTemplate">
            <TextBlock FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                <Run Text="{Binding Name}" /><Run Text=" · " /><Run Text="{Binding StoreScopeLabel, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F7F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Petrol}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="#D9F3F2" VerticalAlignment="Center">
                    <TextBlock Text="ET" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PetrolDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Etikettenstudio" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="HeaderBuildText" Text="v1.9.0 · Entwicklungsbuild" Margin="10,0,0,3" VerticalAlignment="Bottom" FontSize="10.5" FontWeight="SemiBold" Foreground="#D9F3F2" />
                    </StackPanel>
                    <TextBlock Text="WYSIWYG · TSPL/ZPL · RAW-Netzwerk und Windows-Drucker · Brain-Assistent" FontSize="13" Foreground="#D9F3F2" />
                </StackPanel>
                <StackPanel Grid.Column="2" Width="310" VerticalAlignment="Center">
                    <TextBlock Text="ZIELDRUCKER" Foreground="#D9F3F2" FontSize="10" FontWeight="SemiBold" Margin="18,0,0,3" />
                    <DockPanel>
                        <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#B8D6D6" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="TargetPrinterCombo" Height="40" Padding="9,2" Background="White" BorderBrush="#D9F3F2" BorderThickness="1"
                                  ItemTemplate="{StaticResource PrinterItemTemplate}" SelectionChanged="TargetPrinterSelectionChanged" ToolTip="Zieldrucker für den nächsten Ausdruck" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="RootTabs" Grid.Row="1" Margin="18,12,18,8" Background="Transparent" BorderThickness="0">
            <TabItem Header="Etikett gestalten">
                <Grid x:Name="EditorArea" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="EditorToolbarCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProfileCombo" Style="{StaticResource InputStyle}" SelectionChanged="ProfileSelectionChanged" ToolTip="Etikettenformat auswählen" />
                            <Border Grid.Column="1" Background="{StaticResource Line}" Margin="12,1" />
                            <ComboBox x:Name="FontFamilyCombo" Grid.Column="2" Style="{StaticResource InputStyle}" IsEditable="True" SelectionChanged="FontFamilyChanged" ToolTip="Schriftfamilie" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                <ComboBox x:Name="FontSizeCombo" Width="72" Style="{StaticResource InputStyle}" IsEditable="True" IsTextSearchEnabled="False" SelectionChanged="FontSizeChanged" DropDownClosed="FontSizeDropDownClosed" KeyDown="FontSizeKeyDown" ToolTip="Beliebige Schriftgröße direkt eingeben und mit Enter übernehmen" />
                                <TextBlock Text="pt" VerticalAlignment="Center" Margin="5,0,2,0" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <Button x:Name="DecreaseFontSizeButton" Content="A−" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Click="DecreaseFontSizeClick" ToolTip="Schriftgröße um 0,5 pt verkleinern" />
                                <Button x:Name="IncreaseFontSizeButton" Content="A+" Style="{StaticResource ToolbarButton}" Click="IncreaseFontSizeClick" ToolTip="Schriftgröße um 0,5 pt vergrößern" />
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0">
                                <TextBlock Text="Textformat" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <Button Content="B" Style="{StaticResource ToolbarButton}" Click="BoldClick" ToolTip="Fett (Strg+B)" />
                                <Button Content="I" FontStyle="Italic" Style="{StaticResource ToolbarButton}" Click="ItalicClick" ToolTip="Kursiv (Strg+I)" />
                                <Button Content="&#xE8E4;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="AlignLeftClick" ToolTip="Linksbündig" />
                                <Button Content="&#xE8E3;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="AlignCenterClick" ToolTip="Zentriert" />
                                <Button Content="&#xE8E2;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="AlignRightClick" ToolTip="Rechtsbündig" />
                                <Button Content="―" Style="{StaticResource ToolbarButton}" Click="InsertLineClick" ToolTip="Horizontale Trennlinie einfügen" />
                                <ToggleButton x:Name="FormattingMarksToggle" Content="¶" Width="32" Height="32" Checked="FormattingMarksChanged" Unchecked="FormattingMarksChanged" ToolTip="Nichtdruckbare Zeichen anzeigen: · Leerzeichen, → Tabulator, ¶ Absatz, ↵ Zeilenumbruch" />
                                <TextBlock Text="Zeilenhöhe" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,7,0" />
                                <ComboBox x:Name="LineHeightCombo" Width="88" Style="{StaticResource InputStyle}" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="280" SelectionChanged="LineHeightChanged" DropDownClosed="LineHeightDropDownClosed" KeyDown="LineHeightKeyDown" ToolTip="Zeilenhöhe in Punkt auswählen oder eingeben" />
                                <Button Content="−" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Click="DecreaseLineHeightClick" ToolTip="Zeilenhöhe um 0,5 pt verkleinern" />
                                <Button Content="+" Style="{StaticResource ToolbarButton}" Click="IncreaseLineHeightClick" ToolTip="Zeilenhöhe um 0,5 pt vergrößern" />
                                <TextBlock Text="Innenrand mm" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="7,0,7,0" />
                                <ComboBox x:Name="QuickMarginCombo" Width="72" Style="{StaticResource InputStyle}" IsEditable="True" SelectionChanged="QuickMarginChanged" LostKeyboardFocus="QuickMarginLostFocus" KeyDown="QuickMarginKeyDown" ToolTip="Druckbarer Innenrand in Millimeter; 0 nutzt die maximale Etikettenfläche" />
                                <Button x:Name="DecreaseMarginButton" Content="−" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Click="DecreaseMarginClick" ToolTip="Innenrand um 0,5 mm verkleinern" />
                                <Button x:Name="IncreaseMarginButton" Content="+" Style="{StaticResource ToolbarButton}" Click="IncreaseMarginClick" ToolTip="Innenrand um 0,5 mm vergrößern" />
                            </WrapPanel>
                            <WrapPanel x:Name="ImageDesignRowPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0">
                                <TextBlock Text="Bild" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <Button x:Name="InsertImageButton" Content="&#xE91B;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="InsertImageClick" ToolTip="PNG oder JPG auswählen und vollständig in das Etikett einbetten" />
                                <ComboBox x:Name="ImageModeCombo" Width="120" Style="{StaticResource InputStyle}" Margin="7,0,0,0" ToolTip="Position des Logos" SelectionChanged="ImageModeChanged"><ComboBoxItem Content="Inline im Text" Tag="INLINE" /><ComboBoxItem Content="Vor Text · eigene Zeile" Tag="BLOCK" /><ComboBoxItem Content="Textumfluss links" Tag="WRAP_LEFT" /><ComboBoxItem Content="Textumfluss rechts" Tag="WRAP_RIGHT" /><ComboBoxItem Content="Hintergrundgrafik" Tag="BACKGROUND" /></ComboBox>
                                <TextBlock Text="Breite" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,5,0" />
                                <TextBox x:Name="ImageWidthBox" Width="55" Style="{StaticResource InputStyle}" Text="20" ToolTip="Bildbreite in Millimetern (2–1000); übergroße Hintergrundbilder werden am Etikettenrand abgeschnitten" />
                                <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource Muted}" />
                                <ComboBox x:Name="ImageAlignmentCombo" Width="72" Style="{StaticResource InputStyle}" Margin="5,0,0,0" ToolTip="Bildausrichtung"><ComboBoxItem Content="Links" Tag="LEFT" /><ComboBoxItem Content="Mitte" Tag="CENTER" /><ComboBoxItem Content="Rechts" Tag="RIGHT" /></ComboBox>
                                <TextBlock Text="Deckkraft" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="7,0,4,0" />
                                <ComboBox x:Name="ImageOpacityCombo" Width="76" Style="{StaticResource InputStyle}" IsEditable="True" ToolTip="100 % druckt das Bild am kräftigsten; kleinere Werte machen es transparenter"><ComboBoxItem Content="100 %" Tag="100" /><ComboBoxItem Content="75 %" Tag="75" /><ComboBoxItem Content="50 %" Tag="50" /><ComboBoxItem Content="25 %" Tag="25" /><ComboBoxItem Content="10 %" Tag="10" /></ComboBox>
                                <Button x:Name="ApplyImageButton" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Margin="7,0,0,0" Click="ApplyImageSettingsClick" ToolTip="Größe, Ausrichtung und Deckkraft auf das gewählte Bild anwenden" />
                                <Button x:Name="RemoveImageButton" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Click="RemoveImageClick" ToolTip="Gewähltes Logo oder Hintergrundbild entfernen" />
                            </WrapPanel>
                            <WrapPanel x:Name="ImagePositionRowPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,6,0,0" Visibility="Collapsed">
                                <Button Content="Gestalten" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ShowImageDesignClick" ToolTip="Zurück zu Bild einfügen, Modus und Deckkraft" />
                                <TextBlock Text="Bild auswählen &amp; positionieren" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <Button x:Name="PreviousImageButton" Content="‹" Style="{StaticResource ToolbarButton}" Click="PreviousImageClick" ToolTip="Vorheriges Bild als Bearbeitungsziel wählen" />
                                <ToggleButton x:Name="ImageFocusToggle" Width="160" Content="Kein Bild ausgewählt" Style="{StaticResource ImageFocusToggleStyle}" Click="ImageFocusToggleClick" ToolTip="Orange: Dieses Bild bleibt das Bearbeitungsziel, auch während Text editiert wird." />
                                <Button x:Name="NextImageButton" Content="›" Style="{StaticResource ToolbarButton}" Margin="5,0,0,0" Click="NextImageClick" ToolTip="Nächstes Bild als Bearbeitungsziel wählen" />
                                <TextBlock Text="Schritt" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="5,0,4,0" />
                                <TextBox x:Name="ImageStepBox" Width="48" Style="{StaticResource InputStyle}" Text="1" ToolTip="Schrittweite für Verschieben und Größe in Punkt" />
                                <TextBlock Text="pt" VerticalAlignment="Center" Margin="4,0,7,0" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="Position" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <Button Content="←" Tag="LEFT" Style="{StaticResource ToolbarButton}" Click="MoveImageClick" ToolTip="Bild nach links verschieben" />
                                <Button Content="↑" Tag="UP" Style="{StaticResource ToolbarButton}" Click="MoveImageClick" ToolTip="Bild nach oben verschieben" />
                                <Button Content="↓" Tag="DOWN" Style="{StaticResource ToolbarButton}" Click="MoveImageClick" ToolTip="Bild nach unten verschieben" />
                                <Button Content="→" Tag="RIGHT" Style="{StaticResource ToolbarButton}" Click="MoveImageClick" ToolTip="Bild nach rechts verschieben" />
                                <TextBlock Text="Größe" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="4,0,5,0" />
                                <Button x:Name="DecreaseImageSizeButton" Content="−" Tag="-1" Style="{StaticResource ToolbarButton}" Click="NudgeImageSizeClick" ToolTip="Bildbreite um die Schrittweite verkleinern" />
                                <Button x:Name="IncreaseImageSizeButton" Content="+" Tag="1" Style="{StaticResource ToolbarButton}" Click="NudgeImageSizeClick" ToolTip="Bildbreite um die Schrittweite vergrößern" />
                                <TextBlock x:Name="ImageOffsetText" Text="X 0 · Y 0 pt" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="3,0,0,0" />
                            </WrapPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="UndoClick" ToolTip="Rückgängig" />
                                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource ToolbarButton}" Click="NewLabelClick" ToolTip="Neues Etikett" />
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Popup x:Name="TemplateCompactPopup" PlacementTarget="{Binding ElementName=TemplatesCompactButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Width="440" Padding="12" Background="White" BorderBrush="{StaticResource Petrol}" BorderThickness="1" CornerRadius="9">
                            <StackPanel>
                                <TextBlock Text="Vorlage laden" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="CompactTemplatePrinterText" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <ListBox x:Name="CompactTemplateList" Height="230" Margin="0,8" BorderBrush="{StaticResource Line}" ItemTemplate="{StaticResource LabelTemplateItemTemplate}" SelectionChanged="CompactTemplateSelectionChanged" MouseDoubleClick="TemplateListDoubleClick" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="Laden" Style="{StaticResource SecondaryButton}" Padding="5" Click="LoadTemplateClick" />
                                    <Button Grid.Column="1" Content="Speichern…" Style="{StaticResource SecondaryButton}" Padding="5" Margin="4,0" Click="SaveTemplateClick" />
                                    <Button Grid.Column="2" Content="Als neu…" Tag="SAVE_AS_NEW" Style="{StaticResource SecondaryButton}" Padding="5" Margin="0,0,4,0" Click="SaveTemplateClick" ToolTip="Unter einem neuen Namen speichern" />
                                    <Button Grid.Column="3" Content="Löschen" Style="{StaticResource SecondaryButton}" Padding="5" Click="DeleteTemplateClick" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="Platzhalter" Style="{StaticResource SecondaryButton}" Padding="4" Click="NewPlaceholderTemplateClick" />
                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButton}" Padding="4" Margin="4,0" Click="CopyTemplateClick" />
                                    <Button x:Name="CompactTemplatePasteButton" Grid.Column="2" Content="Paste" Style="{StaticResource SecondaryButton}" Padding="4" Click="PasteTemplateClick" IsEnabled="False" />
                                </Grid>
                                <TextBlock Text="%Name% · %Adresse% · %Versicherungsnummer% · %Telefon%" Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="PreviewTitleText" Text="Druckvorschau und Texteingabe" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="PreviewSubtitleText" Text="Text direkt markieren und formatieren. Die weiße Fläche entspricht dem Etikett." Style="{StaticResource FieldLabel}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource PetrolPale}" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock x:Name="PixelInfoText" Text="400 × 240 Punkte" Foreground="{StaticResource PetrolDark}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Border x:Name="LabelStage" Grid.Row="1" Background="#E7EEEE" BorderBrush="#CAD7D8" BorderThickness="1" CornerRadius="10" Margin="0,6,0,5" Padding="18" ClipToBounds="True" PreviewMouseLeftButtonDown="LabelStageMouseDown">
                                    <Viewbox x:Name="LabelViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                                        <Grid x:Name="LabelCanvas" Width="189" Height="113" Background="White">
                                            <RichTextBox x:Name="LabelEditor" Background="White" Foreground="Black" BorderThickness="0" Padding="0"
                                                         AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                                                         IsReadOnly="False" IsDocumentEnabled="True" IsEnabled="True" IsHitTestVisible="True" Focusable="True" IsTabStop="True"
                                                         SpellCheck.IsEnabled="False" PreviewMouseLeftButtonDown="LabelEditorPreviewMouseLeftButtonDown"
                                                         SelectionChanged="EditorSelectionChanged" TextChanged="EditorTextChanged" />

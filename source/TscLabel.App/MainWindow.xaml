                                <TextBlock Text="Offisy / Laborauftrag" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Praxiszeile unter dem Etikett" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <TextBox x:Name="PracticeLineBox" Style="{StaticResource InputStyle}" ToolTip="Beim OCR-Import wird der erkannte Arztname davor gesetzt" />
                                <TextBlock Text="Voreingestellter Download-Ordner" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <TextBox x:Name="DownloadDirectoryBox" Style="{StaticResource InputStyle}" TextWrapping="NoWrap" />
                                <Button Content="Ordner auswählen..." Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="ChooseDownloadDirectoryClick" />
                                <TextBlock Text="Gesucht werden Laborauftrag*.txt und Laboranfrage*.txt; die neueste Datei wird in der Gestaltung angezeigt." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Separator Margin="0,18,0,14" />
                                <TextBlock Text="Etikettenvorlagen verwalten" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Optionaler zentraler Vorlagenpfad" Style="{StaticResource FieldLabel}" Margin="0,8,0,5" />
                                <TextBox x:Name="SharedTemplatePathBox" Style="{StaticResource InputStyle}" ToolTip="Zum Beispiel ein NAS-Pfad zu einer gemeinsamen TSC-Etikettendruck-Vorlagen.json" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="Zentrale Datei wählen…" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="ChooseSharedTemplatePathClick" />
                                    <Button Grid.Column="1" Content="Vorlagen neu laden" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="ReloadTemplatesClick" />
                                </Grid>
                                <TextBlock Text="Speichern neuer Vorlagen" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <ComboBox x:Name="TemplateSaveTargetCombo" Style="{StaticResource InputStyle}" SelectionChanged="TemplateSaveTargetChanged"><ComboBoxItem Content="Lokal auf diesem Computer" Tag="LOCAL" /><ComboBoxItem Content="Zentraler Vorlagenpfad" Tag="SHARED" /></ComboBox>
                                <TextBlock x:Name="SharedTemplateStatusText" Text="Zentraler Speicher nicht eingerichtet." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Separator Margin="0,14,0,12" />
                                <TextBlock Text="Alle Vorlagen einschließlich Logos, Platzhaltern, Formaten und Druckerzuordnungen in eine Datei exportieren oder wieder importieren." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ExportTemplatesButton" Content="Alle Vorlagen exportieren…" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="ExportTemplatesClick" />
                                    <Button x:Name="ImportTemplatesButton" Grid.Column="1" Content="Vorlagen importieren…" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="ImportTemplatesClick" />
                                </Grid>
                                <Separator Margin="0,20,0,16" />
                                <TextBlock Text="Datenschutz" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Clipboard-Bild und OCR-Rohtext werden nicht gespeichert. Etikettentexte landen nur dann im lokalen Druckverlauf neben der EXE, wenn ‚Im Verlauf speichern‘ aktiviert ist. Projektdateien und technische Logs enthalten keine Patientendaten." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" />
                                <Button Content="Alle Einstellungen speichern" Style="{StaticResource ActionButton}" Margin="0,22,0,0" MinHeight="46" Click="SaveSettingsClick" />
                                <TextBlock x:Name="SettingsPathText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Letzte Ausdrucke">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Letzte Ausdrucke" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Maximal 50 lokal gespeicherte Etiketten. Auswahl zeigt Inhalt und Format." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,12,0,12" BorderBrush="{StaticResource Line}" FontSize="13" SelectionChanged="HistorySelectionChanged" />
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="HistoryPathText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                <Button Content="Verlauf leeren" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="ClearHistoryClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Gespeichertes Etikett" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="HistoryDetailsText" Text="Bitte links einen Ausdruck auswählen." Style="{StaticResource FieldLabel}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource PetrolPale}" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                                    <TextBlock x:Name="HistoryModeText" Text="" Foreground="{StaticResource PetrolDark}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#E7EEEE" BorderBrush="#CAD7D8" BorderThickness="1" CornerRadius="10" Margin="0,12" Padding="18">
                                <Viewbox x:Name="HistoryViewbox" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <RichTextBox x:Name="HistoryPreviewEditor" Width="189" Height="113" IsReadOnly="True" IsDocumentEnabled="False"
                                                 Background="White" Foreground="Black" BorderBrush="#BAC7C8" BorderThickness="0.4"
                                                 Padding="6" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                                </Viewbox>
                            </Border>
                            <Button Grid.Row="2" Content="Dieses Etikett wieder in den Editor übernehmen" Style="{StaticResource ActionButton}" MinHeight="46" Click="RestoreHistoryClick" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Petrol}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Bereit" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="13" />
                <TextBlock Grid.Column="2" Text="TSPL · TCP 9100 · 203 dpi" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>

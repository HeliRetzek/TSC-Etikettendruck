<Window x:Class="TscLabel.App.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" MaxHeight="620" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="#F3F7F7" FontFamily="Segoe UI" Title="Hinweis">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="AccentBar" Background="#0F6F73" CornerRadius="7,7,0,0" />
        <Border Grid.Row="1" Padding="24" Background="White">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="#E5F3F3" VerticalAlignment="Top"><TextBlock x:Name="IconText" Text="i" FontSize="21" FontWeight="Bold" Foreground="#0A5559" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock x:Name="DialogTitleText" Grid.Column="1" Text="Hinweis" FontSize="21" FontWeight="SemiBold" Foreground="#17242B" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="MessageText" Grid.Row="1" Margin="46,14,0,0" FontSize="14" Foreground="#293940" TextWrapping="Wrap" LineHeight="21" />
                <Border x:Name="ContextBorder" Grid.Row="2" Margin="46,14,0,0" Padding="10" Background="#F3F7F7" BorderBrush="#D4E0E1" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <TextBlock x:Name="ContextText" FontSize="12" Foreground="#64757D" TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Content="Abbrechen" MinWidth="105" Height="38" Margin="0,0,8,0" Background="White" BorderBrush="#D4E0E1" Foreground="#0A5559" Click="CancelClick" />
                    <Button x:Name="OkButton" Content="OK" MinWidth="105" Height="38" Background="#0F6F73" BorderBrush="#0F6F73" Foreground="White" FontWeight="SemiBold" Click="OkClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

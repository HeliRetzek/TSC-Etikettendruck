<Window x:Class="TscLabel.App.TextInputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorlage benennen" Width="520" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F7F7" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#0F6F73" Padding="18,0">
            <TextBlock x:Name="DialogTitleText" Text="Vorlage speichern" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="1" Margin="14" Padding="16" Background="White" BorderBrush="#D4E0E1" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="PromptText" Text="Aussagekräftiger Vorlagenname" Foreground="#64757D" FontSize="13" />
                <TextBox x:Name="ValueBox" Grid.Row="1" Height="38" Margin="0,7,0,0" Padding="9,5" FontSize="15" BorderBrush="#D4E0E1" BorderThickness="1" KeyDown="ValueBoxKeyDown" />
                <TextBlock x:Name="HintText" Grid.Row="2" Text="Die Vorlage wird nur beim aktuell gewählten Drucker angezeigt." Foreground="#64757D" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Width="105" Height="36" Margin="0,0,8,0" Click="CancelClick" />
                    <Button Content="Speichern" Width="115" Height="36" Background="#0F6F73" Foreground="White" FontWeight="SemiBold" Click="AcceptClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
